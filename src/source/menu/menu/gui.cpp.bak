													gui->dropdown("Gradient Style ", &cur_settings->box_fill_gradient_type, gradient_styles, IM_ARRAYSIZE(gradient_styles));
													if (cur_settings->box_fill_gradient_type == 2)
													{
														gui->slider_float("Pulse Speed ", &cur_settings->box_fill_pulse_speed, 0.1f, 10.0f, false, "%.1fx");
													}
													gui->checkbox("Gradient Spin", &cur_settings->box_fill_gradient_spin);
													if (cur_settings->box_fill_gradient_spin)
													{
														gui->slider_float("Spin Speed", &cur_settings->box_fill_gradient_speed, 0.1f, 10.0f, false, "%.1fx");
													}
												}
											}
											gui->slider_float("Box Thickness", &settings::visuals::box_thickness, 0.5f, 5.0f);
										}

										gui->checkbox("Name", &cur_settings->username, cur_settings->username_colour);
										if (cur_settings->username)
										{
											static const char* const name_modes[] = { "Display Name", "Username", "Both" };
											gui->dropdown("Name Mode", &cur_settings->username_type, name_modes, IM_ARRAYSIZE(name_modes));

											static const char* const name_positions[] = { "Top", "Bottom", "Left", "Right" };
											gui->dropdown("Name Position", &cur_settings->username_position, name_positions, IM_ARRAYSIZE(name_positions));

											static const char* const name_transforms[] = { "None", "Uppercase", "Lowercase" };
											gui->dropdown("Name Transform", &cur_settings->name_transform, name_transforms, IM_ARRAYSIZE(name_transforms));

											gui->checkbox("Name Gradient", &cur_settings->username_gradient, cur_settings->username_colour_two);
											if (cur_settings->username_gradient)
