											}

											if (gui->button("Extract Colors"))
											{
												auto to_hex = [](const ImColor& c) -> std::string {
													char hex[16];
													snprintf(hex, sizeof(hex), "#%02X%02X%02X", (int)(c.Value.x * 255.f), (int)(c.Value.y * 255.f), (int)(c.Value.z * 255.f));
													return std::string(hex);
												};

												std::ostringstream ss;
												ss << "Menu Accent: " << to_hex(clr->accent) << "\n";
												ss << "Contrast One: " << to_hex(clr->window.background_one) << "\n";
												ss << "Contrast Two: " << to_hex(clr->window.background_two) << "\n";
												ss << "Inline: " << to_hex(clr->window.stroke) << "\n";
												ss << "Outline: " << to_hex(clr->widgets.stroke_two) << "\n";
												ss << "Text Active: " << to_hex(clr->widgets.text) << "\n";
												ss << "Text Inactive: " << to_hex(clr->widgets.text_inactive) << "\n";
													ss << "Unsafe Feature: " << to_hex(clr->widgets.unsafe_text) << "\n";

												ImGui::SetClipboardText(ss.str().c_str());
