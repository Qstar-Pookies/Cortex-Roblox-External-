												{
													const char* speed_modes[] = { "Velocity", "Walkspeed", "CFrame" };
													gui->dropdown("Speed Method", &settings::movement::speedhack::mode, speed_modes, IM_ARRAYSIZE(speed_modes));
													gui->slider_float("Speed", &settings::movement::speedhack::speed, 16.f, 300.f);
												}
												gui->checkbox("Flight", &settings::movement::flyhack::enabled, &settings::movement::flyhack::keybind, &settings::movement::flyhack::activation_mode);
												if (settings::movement::flyhack::enabled)
												{
													const char* fly_modes[] = { "Velocity", "CFrame", "CFrame" };
													gui->dropdown("Flight Method", &settings::movement::flyhack::mode, fly_modes, IM_ARRAYSIZE(fly_modes));
													gui->slider_float("Fly Speed", &settings::movement::flyhack::speed, 10.f, 300.f);
												}
												gui->checkbox("Spam Tp", &settings::movement::spam_tp::enabled, &settings::movement::spam_tp::keybind, &settings::movement::spam_tp::activation_mode);
												if (settings::movement::spam_tp::enabled)
												{
													static const char* const spam_tp_modes[] = { "Orbit", "Random", "Behind", "Above" };
													gui->dropdown("Pattern##spam_tp_mode", &settings::movement::spam_tp::mode, spam_tp_modes, IM_ARRAYSIZE(spam_tp_modes));
													gui->slider_float("Radius##spam_tp_rad", &settings::movement::spam_tp::radius, 0.0f, 40.0f, false, "%.1f studs");
													gui->slider_float("Height##spam_tp_hgt", &settings::movement::spam_tp::height, -15.0f, 40.0f, false, "%.1f studs");
													gui->slider_float("Speed##spam_tp_spd", &settings::movement::spam_tp::speed, 1.0f, 30.0f, false, "%.1fx");
												}
												gui->checkbox("Bhop", &settings::movement::bhop::enabled, &settings::movement::bhop::keybind, &settings::movement::bhop::activation_mode);
												if (settings::movement::bhop::enabled)
												{
													gui->slider_float("Bhop Speed", &settings::movement::bhop::speed, 16.f, 200.f);
												}
												gui->checkbox("Noclip", &settings::movement::noclip::enabled, &settings::movement::noclip::keybind, &settings::movement::noclip::activation_mode);
												gui->checkbox("Infinite Jump", &settings::movement::infjump::enabled);
												gui->checkbox("Gravity", &settings::movement::gravity::enabled);
												if (settings::movement::gravity::enabled)
												{
													gui->slider_float("Gravity Level", &settings::movement::gravity::value, 0.f, 400.f);
												}
												gui->checkbox("Tickrate", &settings::movement::tickrate::enabled);
												if (settings::movement::tickrate::enabled)
												{
													gui->slider_float("Tickrate", &settings::movement::tickrate::value, 30.f, 500.f);
												}
												gui->checkbox("Wallbug", &settings::movement::wallbug::enabled);
												if (settings::movement::wallbug::enabled)
												{
													gui->slider_float("Height", &settings::movement::wallbug::height, 5.f, 100.f);
												}
												gui->checkbox("Wallslide", &settings::movement::wallslide::enabled, &settings::movement::wallslide::keybind, &settings::movement::wallslide::activation_mode);
												gui->checkbox("Spider", &settings::movement::spiderman::enabled);
											}
											gui->end_child();
										}
										else if (exploits_subtab == 1)
										{
											gui->begin_child("Remote Spy", 2, 1);
											{
												gui->checkbox("Enabled", &settings::remotespy::enabled);
												if (settings::remotespy::enabled)
												{
													gui->checkbox("Log FireServer", &settings::remotespy::log_fireserver);
													gui->checkbox("Log InvokeServer", &settings::remotespy::log_invokeserver);
													gui->checkbox("Log FireClient", &settings::remotespy::log_fireclient);
													gui->checkbox("Log InvokeClient", &settings::remotespy::log_invokeclient);
													gui->checkbox("Log Property Changes", &settings::remotespy::log_property_changes);
													gui->slider_int("Max Logs", &settings::remotespy::max_logs, 100, 2000);
													gui->checkbox("Auto Scroll", &settings::remotespy::auto_scroll);
													gui->checkbox("Show Args", &settings::remotespy::show_args);
													gui->checkbox("Show Stack Trace", &settings::remotespy::show_stack);
													gui->checkbox("Block Calls", &settings::remotespy::block_calls);
													if (settings::remotespy::block_calls)
													{
														gui->text_field("Blocked Remotes (comma separated)", settings::remotespy::filter_text, sizeof(settings::remotespy::filter_text));
													}
													if (gui->button("Open Remote Spy Window"))
													{
														remotespy::render_window();
													}
												}
											}
											gui->end_child();
										}
										else if (exploits_subtab == 2)
										{
											gui->begin_child("Instance Dumper", 2, 1);
											{
												gui->checkbox("Enabled", &settings::instancedumper::enabled);
												if (settings::instancedumper::enabled)
												{
													keybind::keybind_selector(settings::instancedumper::keybind, reinterpret_cast<keybind::activation_mode&>(settings::instancedumper::activation_mode), "instancedumper_key");
													gui->checkbox("Dump Properties", &settings::instancedumper::dump_properties);
													gui->checkbox("Dump Children", &settings::instancedumper::dump_children);
													gui->checkbox("Dump Scripts", &settings::instancedumper::dump_scripts);
													gui->slider_int("Max Depth", &settings::instancedumper::max_depth, 1, 50);
													gui->checkbox("Auto Open Folder", &settings::instancedumper::auto_open_folder);
													gui->checkbox("Workspace Only", &settings::instancedumper::filter_workspace_only);
													gui->text_field("Class/Name Filter", settings::instancedumper::filter_class, sizeof(settings::instancedumper::filter_class));
													if (gui->button("Dump Workspace"))
													{
														instancedumper::dump_workspace();
													}
													gui->sameline();
													if (gui->button("Dump Game"))
													{
														instancedumper::dump_game();
													}
													gui->sameline();
													if (gui->button("Open Folder"))
													{
														ShellExecuteA(NULL, "open", settings::instancedumper::output_path, NULL, NULL, SW_SHOWNORMAL);
													}
													if (gui->button("Open Instance Dumper Window"))
													{
														instancedumper::render_window();
													}
												}
											}
											gui->end_child();
										}
									}
								}
								gui->end_group();

								gui->sameline();

								gui->begin_group();
								{
									bool is_in_arsenal = (game::datamodel && game::datamodel->address != 0 && game::datamodel->is_arsenal());
									float total_h = GetWindowHeight() - elements->content.padding.y * 2.f - elements->content.spacing.y;

									if (is_in_arsenal)
									{
										gui->begin_child("View", 2, 1, ImVec2(0, total_h * 0.73f - elements->content.spacing.y));
									}
									else
									{
										gui->begin_child("View", 2, 1);
									}
									{
										gui->checkbox("Third Person", &settings::movement::third_person::enabled, &settings::movement::third_person::keybind, &settings::movement::third_person::activation_mode);
										if (settings::movement::third_person::enabled)
										{
											gui->slider_float("Distance", &settings::movement::third_person::distance, 2.f, 80.f);
										}

										gui->checkbox("Free-Cam", &settings::movement::freecam::enabled, &settings::movement::freecam::keybind, &settings::movement::freecam::activation_mode);
										if (settings::movement::freecam::enabled)
										{
											const char* mlook_modes[] = { "Hold RMB", "Always" };
											gui->dropdown("Mouse Look", &settings::movement::freecam::mouse_look_mode, mlook_modes, IM_ARRAYSIZE(mlook_modes));
											gui->slider_float("Camera Speed", &settings::movement::freecam::speed, 0.1f, 10.0f, false, "%.1fx");
											gui->slider_float("Sensitivity", &settings::movement::freecam::sensitivity, 0.0005f, 0.01f, false, "%.4f");
											gui->slider_float("Sprint Boost", &settings::movement::freecam::shift_multiplier, 1.0f, 5.0f, false, "%.1fx");

										}
										gui->checkbox("Desync", &settings::movement::desync::enabled, &settings::movement::desync::keybind, &settings::movement::desync::activation_mode);
										gui->checkbox("No Fall Damage", &settings::movement::no_fall_damage::enabled);
										gui->checkbox("Hip Height", &settings::movement::hipheight::enabled);
										if (settings::movement::hipheight::enabled)
										{
											gui->slider_float("Height", &settings::movement::hipheight::value, 0.f, 25.f);
										}
										gui->checkbox("Long Neck", &settings::movement::longneck::enabled);
										if (settings::movement::longneck::enabled)
										{
											gui->slider_float("Length", &settings::movement::longneck::length, 1.f, 30.f);
										}
										gui->checkbox("Void Hide", &settings::movement::voidhide::enabled, &settings::movement::voidhide::keybind, &settings::movement::voidhide::activation_mode);
										gui->checkbox("Sit State", &settings::movement::sit::enabled);
										gui->checkbox("Platform Stand", &settings::movement::platformstand::enabled);
										gui->checkbox("BTools", &settings::btools::enabled);
										if (settings::btools::enabled)
										{
											const char* tool_types[] = { "Hammer", "Grab", "Clone" };
											gui->dropdown("Tool", &settings::btools::tool_type, tool_types, IM_ARRAYSIZE(tool_types));
											keybind::keybind_selector(settings::btools::keybind, reinterpret_cast<keybind::activation_mode&>(settings::btools::activation_mode), "btools_key");
										}
										gui->checkbox("Auto Emote", &settings::misc::auto_emote, &settings::misc::auto_emote_keybind, &settings::misc::auto_emote_activation_mode);
										if (settings::misc::auto_emote)
										{
											gui->slider_int("Emote Slot", &settings::misc::auto_emote_slot, 1, 9);
											gui->slider_float("Emote Delay", &settings::misc::auto_emote_delay, 10.0f, 500.0f, false, "%.0fms");
											gui->checkbox("Repeat While Held", &settings::misc::auto_emote_repeat);
											if (settings::misc::auto_emote_repeat)
											{
												gui->slider_float("Repeat Interval", &settings::misc::auto_emote_repeat_delay, 100.0f, 3000.0f, false, "%.0fms");
											}
											if (gui->button("Trigger Emote"))
											{
												std::thread([]() {
													misc::auto_emote::perform_emote();
												}).detach();
											}
										}
									}
									gui->end_child();
								}
							}
						}
						gui->end_child();

						bool is_in_arsenal = (game::datamodel && game::datamodel->address != 0 && game::datamodel->is_arsenal());
						float total_h = GetWindowHeight() - elements->content.padding.y * 2.f - elements->content.spacing.y;

						if (is_in_arsenal)
						{
							gui->begin_child("Arsenal", 2, 1, ImVec2(0, total_h * 0.27f));
							{
								gui->checkbox("Fast Fire Rate", &settings::arsenal::fast_fire_rate);
								gui->checkbox("No Recoil", &settings::arsenal::no_recoil);
								gui->checkbox("All Auto", &settings::arsenal::all_auto);
								gui->checkbox("Infinite Ammo", &settings::arsenal::infinite_ammo);
							}
							gui->end_child();
						}
					}
					gui->end_group();
				}
			}
			gui->end_content();
		}

	}
	gui->end();
	gui->sameline();
}

			if (var->gui.current_section[1])
			{
				place_section_window("Players", ImVec2(280.f, 530.f));
				static std::string selected_player_name = "";
				static uint64_t selected_player_uid = 0;
				static bool last_has_selection = false;

				bool has_selection = !selected_player_name.empty();
				if (has_selection != last_has_selection)
				{
					ImGui::SetWindowSize("Players", ImVec2(has_selection ? 660.0f : 280.0f, 530.0f));
					last_has_selection = has_selection;
				}

				float window_w = has_selection ? 660.0f : 280.0f;
				float min_w = has_selection ? 560.0f : 280.0f;

				gui->set_next_window_size(ImVec2(window_w, 530), ImGuiCond_Once);
				gui->set_next_window_size_constraints(ImVec2(min_w, 440), ImVec2(has_selection ? GetIO().DisplaySize.x : 350.0f, GetIO().DisplaySize.y));
				gui->begin("Players", nullptr, var->window.flags);
				{
					draw->window_decorations();

					{
						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + 1));
						gui->begin_content();
						{
							static char player_search_buf[64] = "";

							if (::render && ::render->detail && ::render->detail->device)
							{
								visuals::CAvatarManager::Get().ProcessPendingTextures(::render->detail->device);
							}

							std::vector<cache::entity_t> all_players;
							cache::entity_t local_ent = cache::get_local_player();
							if (local_ent.instance.address != 0)
							{
								all_players.push_back(local_ent);
							}
							{
								std::lock_guard<std::mutex> lock(cache::mtx);
								for (const auto& p : cache::players)
								{
									if (p.instance.address != local_ent.instance.address)
									{
										all_players.push_back(p);
									}
								}
							}
							float total_w = GetContentRegionAvail().x;
							float total_h = GetContentRegionAvail().y;
							bool has_selection = !selected_player_name.empty();
							float left_w = has_selection ? 250.0f : total_w;
							float right_w = total_w - left_w - elements->content.spacing.x;

							gui->begin_group();
							{
								gui->begin_child("Players", 2, 1, ImVec2(left_w, total_h));
								{
									gui->push_font(var->font.tahoma);
									gui->text_field("Search##player_search_box", player_search_buf, sizeof(player_search_buf));

									std::string search_query = player_search_buf;
									std::transform(search_query.begin(), search_query.end(), search_query.begin(), ::tolower);

									ImGui::Dummy(ImVec2(0, 3));

									ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(ImGui::GetStyle().ItemSpacing.x, 4.0f));

									for (size_t i = 0; i < all_players.size(); i++)
									{
										const auto& p = all_players[i];
										bool is_local = (local_ent.instance.address != 0 && p.instance.address == local_ent.instance.address);

										std::string name_lower = p.name;
										std::string disp_lower = p.display_name;
										std::transform(name_lower.begin(), name_lower.end(), name_lower.begin(), ::tolower);
										std::transform(disp_lower.begin(), disp_lower.end(), disp_lower.begin(), ::tolower);

										if (!search_query.empty() && name_lower.find(search_query) == std::string::npos && disp_lower.find(search_query) == std::string::npos)
											continue;

										bool is_selected = (!selected_player_name.empty() && selected_player_name == p.name);
										cache::player_priority prio = is_local ? cache::player_priority::neutral : playerlist::get_priority(p.name);

										ImVec2 card_pos = GetCursorScreenPos();
										float card_w = GetContentRegionAvail().x;
										float card_h = 44.0f;
										ImRect card_rect(card_pos, card_pos + ImVec2(card_w, card_h));

										ImGuiID card_id = GetCurrentWindow()->GetID((std::string("##pcard_") + std::to_string(p.user_id) + "_" + p.name + "_" + std::to_string(i)).c_str());
										ItemSize(card_rect);
										if (ItemAdd(card_rect, card_id))
										{
											bool hovered, held;
											bool pressed = ButtonBehavior(card_rect, card_id, &hovered, &held);
											bool double_clicked = hovered && ImGui::IsMouseDoubleClicked(ImGuiMouseButton_Left);
											if (pressed)
											{
												if (selected_player_name == p.name)
												{
													selected_player_name.clear();
													selected_player_uid = 0;
												}
												else
												{
													selected_player_name = p.name;
													selected_player_uid = p.user_id;
												}
											}
											else if (double_clicked)
											{
												selected_player_name.clear();
												selected_player_uid = 0;
											}

											ImDrawList* dl = GetWindowDrawList();
											ImU32 bg_col = is_selected
												? draw->get_clr(clr->window.background_two)
												: (hovered ? draw->get_clr(clr->window.background_one) : draw->get_clr(clr->window.background_one, 0.5f));
											ImU32 border_col = is_selected ? draw->get_clr(clr->accent) : (hovered ? draw->get_clr(clr->widgets.stroke_two) : draw->get_clr(clr->window.stroke));

											dl->AddRectFilled(card_rect.Min, card_rect.Max, bg_col, 0.0f);
											dl->AddRect(card_rect.Min, card_rect.Max, border_col, 0.0f);

											ImVec2 av_min = card_rect.Min + ImVec2(5, 5);
											ImVec2 av_max = av_min + ImVec2(34, 34);
											dl->AddRectFilled(av_min, av_max, draw->get_clr(clr->window.background_one), 0.0f);
											dl->AddRect(av_min, av_max, draw->get_clr(clr->window.stroke), 0.0f);

											ID3D11ShaderResourceView* avatar_tex = nullptr;
											if (p.user_id != 0 && ::render && ::render->detail && ::render->detail->device)
											{
												avatar_tex = visuals::CAvatarManager::Get().GetAvatar(::render->detail->device, p.user_id, p.name);
											}

											if (avatar_tex)
											{
												dl->AddImage((ImTextureID)avatar_tex, av_min + ImVec2(1, 1), av_max - ImVec2(1, 1));
											}
											else
											{
												std::string init = p.name.empty() ? "?" : p.name.substr(0, 1);
												draw->text_clipped_outline(dl, var->font.tahoma, av_min, av_max, draw->get_clr(clr->accent), init.c_str(), NULL, NULL, ImVec2(0.5f, 0.5f));
											}

											float text_x = av_max.x + 8.0f;
											ImVec2 name_pos = ImVec2(text_x, card_rect.Min.y + 4.0f);
											ImVec2 status_pos = ImVec2(text_x, card_rect.Min.y + 17.0f);
											ImVec2 uid_pos = ImVec2(text_x, card_rect.Min.y + 30.0f);

											ImU32 name_col = is_selected ? draw->get_clr(clr->accent) : draw->get_clr(clr->widgets.text);
											draw->text_outline(dl, var->font.tahoma, var->font.tahoma->FontSize, name_pos, name_col, p.name.c_str());

											const char* prio_str = is_local ? "Client" : ((prio == cache::player_priority::hostile) ? "Hostile" : ((prio == cache::player_priority::friendly) ? "Friendly" : "Neutral"));
											ImU32 prio_col = is_local
												? draw->get_clr(clr->accent)
												: ((prio == cache::player_priority::hostile) ? IM_COL32(240, 70, 70, 255) : ((prio == cache::player_priority::friendly) ? IM_COL32(70, 230, 90, 255) : draw->get_clr(clr->widgets.text_inactive)));
											draw->text_outline(dl, var->font.tahoma, var->font.tahoma->FontSize, status_pos, prio_col, prio_str);

											std::string uid_str = "ID: " + std::to_string(p.user_id);
											draw->text_outline(dl, var->font.tahoma, var->font.tahoma->FontSize, uid_pos, draw->get_clr(clr->widgets.text_inactive), uid_str.c_str());
										}

									}
									ImGui::PopStyleVar();
									gui->pop_font();
								}
								gui->end_child();
							}
							gui->end_group();

							if (has_selection)
							{
								gui->sameline();

								gui->begin_group();
								{
									gui->begin_child("Selected", 2, 1, ImVec2(right_w, total_h));
									{
										cache::entity_t sel_ent{};
										bool found = false;
										for (const auto& p : all_players)
										{
											if (p.name == selected_player_name || (selected_player_uid != 0 && p.user_id == selected_player_uid))
											{
												sel_ent = p;
												found = true;
												break;
											}
										}

										if (found)
										{
											bool is_local = (local_ent.instance.address != 0 && sel_ent.instance.address == local_ent.instance.address);

											float canvas_w = GetContentRegionAvail().x;
											float canvas_h = 240.0f;
											ImVec2 canvas_size(canvas_w, canvas_h);

											ImVec2 img_pos = GetCursorScreenPos();
											ImDrawList* dl = GetWindowDrawList();
											ID3D11ShaderResourceView* full_avatar_tex = nullptr;
											if (sel_ent.user_id != 0 && ::render && ::render->detail && ::render->detail->device)
											{
												full_avatar_tex = visuals::CAvatarManager::Get().GetFullAvatar(::render->detail->device, sel_ent.user_id, sel_ent.name);
												if (!full_avatar_tex)
												{
													full_avatar_tex = visuals::CAvatarManager::Get().GetAvatar(::render->detail->device, sel_ent.user_id, sel_ent.name);
												}
											}

											if (full_avatar_tex)
											{
												float img_dim = (std::min)(canvas_w, canvas_h);
												ImVec2 p_center = img_pos + canvas_size * 0.5f;
												ImVec2 p_min = p_center - ImVec2(img_dim * 0.5f, img_dim * 0.5f);
												ImVec2 p_max = p_center + ImVec2(img_dim * 0.5f, img_dim * 0.5f);
												dl->AddImage((ImTextureID)full_avatar_tex, p_min, p_max);
											}
											else
											{
												std::string init = sel_ent.name.empty() ? "Loading..." : sel_ent.name;
												draw->text_clipped_outline(dl, var->font.tahoma, img_pos, img_pos + canvas_size, draw->get_clr(clr->widgets.text_inactive), init.c_str(), NULL, NULL, ImVec2(0.5f, 0.5f));
											}

											ImGui::Dummy(canvas_size + ImVec2(0, 4));

											gui->push_font(var->font.tahoma);
											auto draw_info_row = [&](const char* label, const std::string& val, ImU32 val_col) {
												gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));
												TextUnformatted(label);
												gui->pop_style_color();
												gui->sameline();
												gui->push_style_color(ImGuiCol_Text, val_col);
												TextUnformatted(val.c_str());
												gui->pop_style_color();
											};

											draw_info_row("Display:", sel_ent.display_name.empty() ? sel_ent.name : sel_ent.display_name, draw->get_clr(clr->accent));
											draw_info_row("Username:", sel_ent.name, draw->get_clr(clr->accent));
											draw_info_row("ID:", std::to_string(sel_ent.user_id), draw->get_clr(clr->accent));

											int approx_days = (int)(sel_ent.user_id > 100000000 ? (1000 + (sel_ent.user_id % 2000)) : 3500);
											draw_info_row("Account age:", std::to_string(approx_days) + " days", draw->get_clr(clr->accent));

											std::ostringstream pos_ss;
											pos_ss << std::fixed << std::setprecision(1) << sel_ent.position.x << ", " << sel_ent.position.y << ", " << sel_ent.position.z;
											draw_info_row("Position:", pos_ss.str(), draw->get_clr(clr->accent));

											ImGui::Dummy(ImVec2(0, 2));

											bool is_current_spectating = playerlist::is_spectating() && playerlist::get_spectating_name() == sel_ent.name;
											const char* spec_btn_text = is_current_spectating ? "Stop Spectating##p_spectate" : "Spectate##p_spectate";

											if (gui->button(spec_btn_text, is_current_spectating ? 1 : 2))
											{
												if (is_current_spectating)
												{
													playerlist::stop_spectating();
													notifications::add("Stopped spectating");
												}
												else
												{
													playerlist::start_spectating(sel_ent.name);
													notifications::add("Spectating " + sel_ent.name);
												}
											}
											gui->sameline();
											if (gui->button("Bring##p_bring", 2))
											{
												notifications::add("Bring requested for " + sel_ent.name);
											}

											if (gui->button("Teleport##p_teleport", 2))
											{
												if (sel_ent.position.x != 0.f || sel_ent.position.y != 0.f || sel_ent.position.z != 0.f)
												{
													waypoints::teleport_to_pos(sel_ent.position);
													notifications::add("Teleported to " + sel_ent.name);
												}
												else
												{
													notifications::add("Invalid player coordinates");
												}
											}
											gui->sameline();
											if (gui->button("Freeze##p_freeze", 2))
											{
												notifications::add("Freeze toggled on " + sel_ent.name);
											}

											if (gui->button("View Backpack##p_backpack", 2))
											{
												std::string tool = sel_ent.tool_name.empty() ? "No tools equipped" : ("Equipped: " + sel_ent.tool_name);
												notifications::add(sel_ent.name + " - " + tool);
											}
											gui->sameline();
											if (gui->button("Open Profile##p_profile", 2))
											{
												if (sel_ent.user_id != 0)
												{
													std::string url = "https://www.roblox.com/users/" + std::to_string(sel_ent.user_id) + "/profile";
													ShellExecuteA(NULL, "open", url.c_str(), NULL, NULL, SW_SHOWNORMAL);
												}
											}

											gui->sameline();
									}
									gui->end_child();
								}
								gui->end_group();
							}
						}
						gui->end_content();
					}

				}
				gui->end();
				gui->sameline();
			}
			}

			if (var->gui.viewer_open)
			{
				ImGuiWindow* home_win = ImGui::FindWindowByName("Home");
				if (home_win)
				{
					float preview_x = home_win->Pos.x + home_win->Size.x + 10.f;
					if (preview_x + 350.f > GetIO().DisplaySize.x)
					{
						preview_x = home_win->Pos.x - 350.f - 10.f;
						if (preview_x < 10.f) preview_x = 10.f;
					}
					float preview_y = home_win->Pos.y;
					gui->set_next_window_pos(ImVec2(preview_x, preview_y), ImGuiCond_Always);
				}
				else
				{
					float start_x = (GetIO().DisplaySize.x - 600.f) * 0.5f + 610.f;
					if (start_x + 350.f > GetIO().DisplaySize.x) start_x = (GetIO().DisplaySize.x - 600.f) * 0.5f - 360.f;
					if (start_x < 10.f) start_x = 10.f;
					float start_y = 65.f;
					gui->set_next_window_pos(ImVec2(start_x, start_y), ImGuiCond_Always);
				}
				gui->set_next_window_size(ImVec2(350, 440), ImGuiCond_Once);
				gui->set_next_window_size_constraints(ImVec2(300, 350), GetIO().DisplaySize);
				gui->begin("Viewer", nullptr, var->window.flags);
				{
					draw->window_decorations();
					{
						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + 1));
						gui->begin_content();
						{
							gui->begin_group();
							{
								gui->begin_child("Preview", 1, 1, ImVec2(0, 0));
								{
									ImVec2 canvas_size = ImGui::GetContentRegionAvail();
									if (canvas_size.x > 10.f && canvas_size.y > 10.f && ::render && ::render->detail && ::render->detail->device && ::render->detail->device_context)
									{
										if (ModelViewer::g_model_viewer.CreateOffscreenResources(::render->detail->device, canvas_size.x, canvas_size.y))
										{
											ModelViewer::g_model_viewer.Render3D(::render->detail->device_context, canvas_size.x, canvas_size.y);
											ID3D11ShaderResourceView* srv = ModelViewer::g_model_viewer.GetShaderResourceView();
											if (srv)
											{
												ImGui::Image(reinterpret_cast<ImTextureID>(srv), canvas_size);
												ModelViewer::g_model_viewer.RenderESPOverlay(ImGui::GetItemRectMin(), canvas_size);
												if (ImGui::IsItemHovered())
												{
													if (ImGui::IsMouseDoubleClicked(ImGuiMouseButton_Left))
													{
														ModelViewer::g_model_viewer.RefreshAvatar();
													}
													ImGuiIO& io = ImGui::GetIO();
													if (io.MouseWheel != 0.0f)
													{
														ModelViewer::g_model_viewer.cam_distance -= io.MouseWheel * 0.3f;
														ModelViewer::g_model_viewer.cam_distance = std::clamp(ModelViewer::g_model_viewer.cam_distance, 1.2f, 20.0f);
													}
													if (ImGui::IsMouseDragging(ImGuiMouseButton_Left) && !ModelViewer::g_model_viewer.is_dragging_healthbar)
													{
														ModelViewer::g_model_viewer.cam_yaw += io.MouseDelta.x * 0.005f;
														ModelViewer::g_model_viewer.cam_pitch += io.MouseDelta.y * 0.005f;
														ModelViewer::g_model_viewer.cam_pitch = std::clamp(ModelViewer::g_model_viewer.cam_pitch, -1.55f, 1.55f);
													}
													else if (ImGui::IsMouseDragging(ImGuiMouseButton_Right) || ImGui::IsMouseDragging(ImGuiMouseButton_Middle))
													{
														float pan_speed = ModelViewer::g_model_viewer.cam_distance * 0.002f;
														ModelViewer::g_model_viewer.cam_target.x -= io.MouseDelta.x * pan_speed * cosf(ModelViewer::g_model_viewer.cam_yaw);
														ModelViewer::g_model_viewer.cam_target.z += io.MouseDelta.x * pan_speed * sinf(ModelViewer::g_model_viewer.cam_yaw);
														ModelViewer::g_model_viewer.cam_target.y += io.MouseDelta.y * pan_speed;
													}
												}
											}
										}
									}
								}
								gui->end_child();
							}
							gui->end_group();
						}
						gui->end_content();
					}
				}
				gui->end();
				gui->sameline();
			}

			if (var->gui.current_section[3])
			{
				place_section_window("Explorer", ImVec2(680.f, 520.f));
				gui->set_next_window_size(ImVec2(680, 520), ImGuiCond_Once);
				gui->set_next_window_size_constraints(ImVec2(500, 400), GetIO().DisplaySize);
				gui->begin("Explorer", nullptr, var->window.flags);
				{
					draw->window_decorations();
					{
						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + 1));
						gui->begin_content();
						{
							if (!explorer::explorer->root && !explorer::explorer->is_refreshing)
							{
								explorer::run();
							}

							gui->begin_group();
							{
								gui->begin_child("Explorer", 2, 1);
								{
									if (gui->button("Refresh"))
									{
										explorer::run();
										notifications::add("Refreshing...");
									}

									ImGui::BeginChild("tree_scroll_area_embedded", ImVec2(0, 0), false, ImGuiWindowFlags_HorizontalScrollbar);
									if (explorer::explorer->root)
									{
										explorer::explorer->render_node(explorer::explorer->root);
									}
									else
									{
										if (explorer::explorer->is_refreshing)
											ImGui::TextDisabled("Scanning game...");
										else
											ImGui::TextDisabled("Click Refresh.");
									}
									ImGui::EndChild();
								}
								gui->end_child();
							}
							gui->end_group();

							gui->sameline();

							gui->begin_group();
							{
								gui->begin_child("Properties", 2, 1);
								{
									if (explorer::explorer->selected_node)
									{
										explorer::explorer->render_properties();
									}
									else
									{
										ImGui::TextDisabled("Select an instance from the hierarchy tree.");
									}
								}
								gui->end_child();
							}
							gui->end_group();
						}
						gui->end_content();
					}
				}
				gui->end();
				gui->sameline();
			}

			if (var->gui.current_section[4])
			{
				place_section_window("Code", ImVec2(560.f, 500.f));
				gui->set_next_window_size(ImVec2(560, 500), ImGuiCond_Once);
				gui->set_next_window_size_constraints(ImVec2(450, 400), GetIO().DisplaySize);
				gui->begin("Code", nullptr, var->window.flags);
				{
					draw->window_decorations();
					{
						static int code_subtab = 0;
						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar));
						gui->begin_group();
						{
							gui->sub_section("Executor", 0, code_subtab, 2);
							gui->sub_section("Settings", 1, code_subtab, 2);
						}
						gui->end_group();

						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + elements->section.height - 1));
						gui->begin_content();
						{
							if (code_subtab == 0)
							{
								gui->begin_group();
								{
									ImGuiID exec_box_id = GetCurrentWindow()->GetID("Executor Area");
									gui->begin_multi_subtab(
										"Executor Area",
										1,
										1,
										2,
										ImVec2(0, 0),
										{ "Luau", "Console" }
									);
									{
										int exec_subtab = gui->get_child_subtab(exec_box_id);
										if (exec_subtab == 0)
										{
											float editor_h = (std::max)(120.f, GetContentRegionAvail().y - 28.f);
											g_lua_editor.render("##code_executor_box", ImVec2(0, editor_h));

											if (gui->button("Execute", 2))
											{
												std::string code = g_lua_editor.get_text();
												if (!code.empty())
												{
													LuaVM::Execute(code);
													notifications::add("Executed!");
												}
											}
											gui->sameline();
											if (gui->button("Clear Editor", 2))
											{
												g_lua_editor.set_text("");
											}
										}
										else if (exec_subtab == 1)
										{
											auto logs = LuaVM::GetLogs();
											float console_h = (std::max)(100.f, GetContentRegionAvail().y - 32.f);

											gui->push_style_var(ImGuiStyleVar_WindowPadding, ImVec2(6, 6));
											gui->begin_def_child("lua_console_scroll", ImVec2(GetWindowWidth() - elements->content.padding.x * 2.f, console_h), ImGuiChildFlags_None, ImGuiWindowFlags_AlwaysUseWindowPadding | ImGuiWindowFlags_NoMove);
											{
												gui->push_font(var->font.tahoma);
												if (logs.empty())
												{
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));
													TextUnformatted("Lua console output will appear here...");
													gui->pop_style_color();
												}
												else
												{
													for (const auto& entry : logs)
													{
														if (entry.is_error)
															gui->push_style_color(ImGuiCol_Text, IM_COL32(255, 87, 87, 255));
														else
															gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text));

														TextUnformatted(entry.message.c_str());
														gui->pop_style_color();
													}
													if (ImGui::GetScrollY() >= ImGui::GetScrollMaxY())
														ImGui::SetScrollHereY(1.0f);
												}
												gui->pop_font();
											}
											gui->end_def_child();
											gui->pop_style_var();

											if (gui->button("Clear Console", 2))
											{
												LuaVM::ClearLogs();
												notifications::add("Console Cleared!");
											}
											gui->sameline();
											static char quick_cmd[256] = "";
											gui->text_field("##quick_cmd_box", quick_cmd, sizeof(quick_cmd));
											if (ImGui::IsItemFocused() && (GetAsyncKeyState(VK_RETURN) & 0x1))
											{
												if (strlen(quick_cmd) > 0)
												{
													LuaVM::Execute(quick_cmd);
													quick_cmd[0] = '\0';
												}
											}
										}
									}
									gui->end_child();
								}
								gui->end_group();
							}
							else if (code_subtab == 1)
							{
								gui->begin_group();
								{
									ImGuiID settings_box_id = GetCurrentWindow()->GetID("Code Settings");
									gui->begin_multi_subtab(
										"Code Settings",
										1,
										1,
										2,
										ImVec2(0, 0),
										{ "Presets", "Settings" }
									);
									{
										int settings_subtab = gui->get_child_subtab(settings_box_id);
										if (settings_subtab == 0)
										{
											static char script_name[64] = "myscript";
											static int selected_script_idx = -1;
											std::vector<std::string> scripts = config::get_script_list();

											gui->begin_child("Presets", 1, 2);
											{
												gui->push_font(var->font.tahoma);
												if (scripts.empty())
												{
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));
													TextUnformatted("No presets found. Save one below!");
													gui->pop_style_color();
												}
												else
												{
													for (size_t i = 0; i < scripts.size(); i++)
													{
														bool is_sel = (selected_script_idx == (int)i);
														if (is_sel)
															gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->accent));
														else
															gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));

														std::string disp = scripts[i];
														ImVec2 sz = CalcTextSize(disp.c_str());
														float avail_w = GetContentRegionAvail().x;
														float cx = (avail_w - sz.x) * 0.5f;
														if (cx > 0) SetCursorPosX(cx);

														draw->text_outline(disp.c_str());
														if (IsItemClicked())
														{
															selected_script_idx = (int)i;
															strncpy_s(script_name, scripts[i].c_str(), sizeof(script_name) - 1);
														}

														gui->pop_style_color();

														ImVec2 item_max = GetItemRectMax();
														float win_min_x = GetWindowPos().x + elements->widgets.padding.x;
														float win_max_x = GetWindowPos().x + GetWindowWidth() - elements->widgets.padding.x;
														float line_y = item_max.y + 4.0f;
														draw->line(GetWindowDrawList(), ImVec2(win_min_x, line_y), ImVec2(win_max_x, line_y), draw->get_clr(clr->window.stroke));
														SetCursorPosY(GetCursorPosY() + 7.0f);
													}
												}
												gui->pop_font();
											}
											gui->end_child();

											gui->begin_child("Actions", 1, 2);
											{
												gui->text_field("##script_name_box", script_name, sizeof(script_name));

												if (gui->button("Save to Preset", 2))
												{
													if (strlen(script_name) > 0)
													{
														std::string code = g_lua_editor.get_text();
														config::save_script(script_name, code);
														scripts = config::get_script_list();
														notifications::add("Script Saved: " + std::string(script_name));
													}
												}
												gui->sameline();
												if (gui->button("Load to Editor", 2))
												{
													if (selected_script_idx >= 0 && selected_script_idx < (int)scripts.size())
													{
														std::string code = config::load_script(scripts[selected_script_idx]);
														g_lua_editor.set_text(code);
														notifications::add("Loaded to Editor: " + scripts[selected_script_idx]);
													}
												}

												if (gui->button("Execute Preset", 2))
												{
													if (selected_script_idx >= 0 && selected_script_idx < (int)scripts.size())
													{
														std::string code = config::load_script(scripts[selected_script_idx]);
														if (!code.empty())
														{
															LuaVM::Execute(code);
															notifications::add("Executed: " + scripts[selected_script_idx]);
														}
													}
												}
												gui->sameline();
												if (gui->button("Delete Preset", 2))
												{
													if (selected_script_idx >= 0 && selected_script_idx < (int)scripts.size())
													{
														config::delete_script(scripts[selected_script_idx]);
														scripts = config::get_script_list();
														selected_script_idx = -1;
														notifications::add("Script Deleted!");
													}
												}

												if (gui->button("Refresh List", 1))
												{
													scripts = config::get_script_list();
													notifications::add("Scripts Refreshed!");
												}
											}
											gui->end_child();
										}
										else if (settings_subtab == 1)
										{
											if (gui->checkbox("Mcp Bridge", &settings::mcp::enabled))
											{
												if (settings::mcp::enabled)
													notifications::add("Mcp Server enabled on port " + std::to_string(settings::mcp::port));
												else
													notifications::add("Mcp Server disabled");
											}

											if (gui->button("Copy Info", 1))
											{
												int port = settings::mcp::port;
												std::string info = "http://127.0.0.1:" + std::to_string(port) + "/mcp (Server Port: " + std::to_string(port) + ")";
												SetClipboardText(info.c_str());
												notifications::add("Mcp connection info copied to clipboard!");
											}
										}
									}
									gui->end_child();
								}
								gui->end_group();
							}
						}
						gui->end_content();
					}
				}
				gui->end();
				gui->sameline();
			}

			static bool s_style_was_open = false;
			if (var->gui.current_section[5])
			{
				place_section_window("Style", ImVec2(466.f, 475.f));
				if (!s_style_was_open)
				{
					settings::theme::accent[0] = clr->accent.Value.x; settings::theme::accent[1] = clr->accent.Value.y; settings::theme::accent[2] = clr->accent.Value.z; settings::theme::dark_accent[0] = clr->dark_accent.Value.x; settings::theme::dark_accent[1] = clr->dark_accent.Value.y; settings::theme::dark_accent[2] = clr->dark_accent.Value.z;
					settings::theme::background_one[0] = clr->window.background_one.Value.x; settings::theme::background_one[1] = clr->window.background_one.Value.y; settings::theme::background_one[2] = clr->window.background_one.Value.z;
					settings::theme::background_two[0] = clr->window.background_two.Value.x; settings::theme::background_two[1] = clr->window.background_two.Value.y; settings::theme::background_two[2] = clr->window.background_two.Value.z;
					settings::theme::stroke[0] = clr->window.stroke.Value.x; settings::theme::stroke[1] = clr->window.stroke.Value.y; settings::theme::stroke[2] = clr->window.stroke.Value.z;
					settings::theme::stroke_two[0] = clr->widgets.stroke_two.Value.x; settings::theme::stroke_two[1] = clr->widgets.stroke_two.Value.y; settings::theme::stroke_two[2] = clr->widgets.stroke_two.Value.z;
					settings::theme::text[0] = clr->widgets.text.Value.x; settings::theme::text[1] = clr->widgets.text.Value.y; settings::theme::text[2] = clr->widgets.text.Value.z;
					settings::theme::text_inactive[0] = clr->widgets.text_inactive.Value.x; settings::theme::text_inactive[1] = clr->widgets.text_inactive.Value.y; settings::theme::text_inactive[2] = clr->widgets.text_inactive.Value.z; settings::theme::unsafe_text[0] = clr->widgets.unsafe_text.Value.x; settings::theme::unsafe_text[1] = clr->widgets.unsafe_text.Value.y; settings::theme::unsafe_text[2] = clr->widgets.unsafe_text.Value.z;
