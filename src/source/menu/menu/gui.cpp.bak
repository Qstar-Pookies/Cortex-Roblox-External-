										gui->checkbox("Health Bar", &cur_settings->healthbar, cur_settings->healthbar_colour, cur_settings->healthbar_colour_mid, cur_settings->healthbar_colour_low);
										if (cur_settings->healthbar)
										{
											gui->dropdown("Position", &cur_settings->healthbar_style, healthbar_positions, IM_ARRAYSIZE(healthbar_positions));
											gui->slider_float("Padding", &cur_settings->healthbar_padding, 0.f, 20.f);
											gui->checkbox("Health Text", &cur_settings->healthbar_text, cur_settings->healthbar_text_colour);
											gui->checkbox("Value Follow", &cur_settings->value_follow);
											gui->checkbox("Health Lerp", &cur_settings->healthbar_lerp);
											gui->checkbox("Ignore Full HP", &cur_settings->ignore_full);
											gui->checkbox("Bar Fold", &cur_settings->bar_fold);
											gui->checkbox("Bar Fill", &settings::visuals::bar_fill, settings::visuals::bar_fill_colour);
											gui->dropdown("Gradient Style", &cur_settings->healthbar_gradient_type, healthbar_gradients, IM_ARRAYSIZE(healthbar_gradients));
											if (cur_settings->healthbar_gradient_type == 2)
											{
												gui->slider_float("Pulse Speed", &cur_settings->healthbar_pulse_speed, 0.5f, 5.0f);
											}
											gui->slider_float("Health Bar Thickness", &settings::visuals::healthbar_thickness, 1.0f, 6.0f);
										}

										gui->checkbox("Tracers", &cur_settings->tracers, cur_settings->tracers_colour);
										if (cur_settings->tracers)
										{
											gui->dropdown("Tracers Origin", &cur_settings->tracers_origin, tracer_origins, IM_ARRAYSIZE(tracer_origins));
											gui->slider_float("Tracer Thickness", &cur_settings->tracers_thickness, 0.5f, 5.0f);
										}

										gui->checkbox("Skeleton", &cur_settings->skeleton, cur_settings->skeleton_colour, cur_settings->skeleton_outline_colour);
										if (cur_settings->skeleton)
										{
											gui->slider_float("Skeleton Thickness", &settings::visuals::skeleton_thickness, 0.5f, 5.0f);
										}

										gui->checkbox("Offscreen Arrows", &cur_settings->offscreen_arrows, cur_settings->offscreen_arrows_colour, cur_settings->arrows_glow_colour);
										if (cur_settings->offscreen_arrows)
										{
											const char* arrow_types[] = { "Normal", "Flat" };
											gui->dropdown("Arrow Type", &cur_settings->arrow_type, arrow_types, IM_ARRAYSIZE(arrow_types));
											const char* arrow_modes[] = { "Screen Center", "Mouse Position" };
											gui->dropdown("Arrow Mode", &cur_settings->arrow_mode, arrow_modes, IM_ARRAYSIZE(arrow_modes));
											const char* arrow_info_labels[] = { "Name", "Distance" };
											gui->multi_dropdown("Arrow Info", cur_settings->arrows_info, arrow_info_labels, IM_ARRAYSIZE(arrow_info_labels));
											gui->checkbox("Arrows Glow", &cur_settings->arrows_glow);
											gui->slider_float("Arrow Radius", &cur_settings->offscreen_arrows_radius, 50.f, 400.f);
											gui->slider_float("Arrow Size", &cur_settings->offscreen_arrows_size, 5.f, 30.f);
										}

										gui->checkbox("Chams", &cur_settings->chams, cur_settings->chams_colour);

										gui->checkbox("Native Chams", &cur_settings->native, settings::visuals::native_render_col);
										gui->checkbox("Engine Chams", &settings::visuals::engine_chams);
										const bool native_panel = cur_settings->native;
										const bool engine_panel = settings::visuals::engine_chams;
										if (cur_settings->chams || engine_panel || native_panel)
										{
											if (cur_settings->chams)
												gui->dropdown("Chams Type", &cur_settings->chams_type, chams_types, IM_ARRAYSIZE(chams_types));
											if (cur_settings->chams && cur_settings->chams_type == 1)
											{
