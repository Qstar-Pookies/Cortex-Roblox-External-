											gui->slider_float("Rotation Speed", &ModelViewer::g_model_viewer.rotate_speed, 0.1f, 3.0f);
										}

										gui->checkbox("Disable Confirmations", &settings::config_system::disable_confirmations);
										gui->checkbox("Confirm on Unload", &settings::general::confirm_unload);
										gui->checkbox("Disable Scroll Bars", &settings::misc::disable_scrollbars);
										gui->checkbox("Bot Support", &settings::misc::bot_support);
										if (settings::misc::bot_support)
										{
											gui->checkbox("Only Workspace.Bots", &settings::misc::only_workspace_bots);
										}

										if (gui->button("Export", 1))
										{
											config::export_config_to_clipboard();
											notifications::add("Config exported to clipboard!");
										}

										if (gui->button("Import", 1))
										{
											config::import_config_from_clipboard();
											notifications::add("Config imported from clipboard!");
										}

										if (gui->button("Open Config Folder", 1))
										{
											ShellExecuteA(NULL, "open", config::get_config_directory().c_str(), NULL, NULL, SW_SHOWNORMAL);
										}

										if (gui->button("Open Resources Folder", 1))
										{
											config::ensure_resources_directory();
											ShellExecuteA(NULL, "open", config::get_resources_directory().c_str(), NULL, NULL, SW_SHOWNORMAL);
										}
									}
									gui->end_child();
								}
								gui->end_group();
							}
						}
						gui->end_content();
					}

				}
				gui->end();
				gui->sameline();
			}

			if (var->gui.current_section[7])
			{
				place_section_window("Waypoints", ImVec2(360.f, 420.f));
				gui->set_next_window_size(ImVec2(360, 420), ImGuiCond_Once);
				gui->set_next_window_size_constraints(ImVec2(260, 260), GetIO().DisplaySize);
				gui->begin("Waypoints", nullptr, var->window.flags);
				{
					draw->window_decorations();

					{
						static int waypoints_subtab = 0;
						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar));
						gui->begin_group();
						{
							gui->sub_section("Waypoints", 0, waypoints_subtab, 2);
							gui->sub_section("Profiles", 1, waypoints_subtab, 2);
						}
						gui->end_group();

						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + elements->section.height - 1));
						gui->begin_content();
						{
							if (waypoints_subtab == 0)
							{
								static char new_wp_name[64] = "Base";
								static int selected_wp_idx = -1;

								std::vector<waypoints::Waypoint>& wps = waypoints::get_active_waypoints();

								float controls_height = 103.f;
								float total_avail = GetWindowHeight() - elements->content.padding.y * 2.f;
								float saved_wp_height = total_avail - controls_height - elements->content.spacing.y;

								gui->begin_group();
								{
									gui->begin_child("Saved Waypoints", 1, 1, ImVec2(0, saved_wp_height));
									{
										gui->push_font(var->font.tahoma);
										if (!wps.empty())
										{
											math::vector3 local_pos{ 0.f, 0.f, 0.f };
											cache::entity_t local_ent = cache::get_local_player();
											if (local_ent.humanoid_root_part.address)
											{
												rbx::c_instance hrp(local_ent.humanoid_root_part.address);
												local_pos = hrp.get_primitive().get_position();
											}

											for (size_t i = 0; i < wps.size(); i++)
											{
												bool is_sel = (selected_wp_idx == (int)i);
												if (is_sel)
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->accent));
												else
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));

												float dist = (wps[i].pos - local_pos).length();
												std::stringstream ss;
												ss << wps[i].name << " [" << (int)wps[i].pos.x << ", " << (int)wps[i].pos.y << ", " << (int)wps[i].pos.z << "] (" << (int)dist << "m)";
												std::string line = ss.str();

												ImVec2 sz = CalcTextSize(line.c_str());
												float avail_w = GetContentRegionAvail().x;
												float cx = (avail_w - sz.x) * 0.5f;
												if (cx > 0) SetCursorPosX(cx);

												draw->text_outline(line.c_str());
												if (IsItemClicked())
												{
													selected_wp_idx = (int)i;
													strncpy_s(new_wp_name, wps[i].name.c_str(), sizeof(new_wp_name) - 1);
												}

												gui->pop_style_color();
											}
										}
										gui->pop_font();
									}
									gui->end_child();

									gui->begin_child("Waypoint Controls", 1, 1, ImVec2(0, controls_height));
									{
										gui->text_field("##wp_name_field", new_wp_name, sizeof(new_wp_name));

										if (gui->button("Add Current Pos", 2))
										{
											math::vector3 local_pos{ 0.f, 0.f, 0.f };
											cache::entity_t local_ent = cache::get_local_player();
											if (local_ent.humanoid_root_part.address)
											{
												rbx::c_instance hrp(local_ent.humanoid_root_part.address);
												local_pos = hrp.get_primitive().get_position();
											}
											else if (game::camera != 0)
											{
												rbx::c_primitive cam(game::camera);
												local_pos = cam.get_position();
											}

											uint64_t pid = 0, gid = 0;
											if (game::datamodel && game::datamodel->address >= 0x10000)
											{
												pid = memory->read<uint64_t>(game::datamodel->address + Offsets::DataModel::PlaceId);
												gid = memory->read<uint64_t>(game::datamodel->address + Offsets::DataModel::GameId);
											}

											waypoints::add_waypoint(new_wp_name, local_pos, gid, pid);
											selected_wp_idx = (int)wps.size() - 1;
											notifications::add("Waypoint Added: " + std::string(new_wp_name));
										}
										gui->sameline();
										if (gui->button("Teleport to Waypoint", 2))
										{
											if (selected_wp_idx >= 0 && selected_wp_idx < (int)wps.size())
											{
												if (waypoints::teleport_to_waypoint((size_t)selected_wp_idx))
												{
													notifications::add("Teleported to " + wps[selected_wp_idx].name);
												}
												else
												{
													notifications::add("Teleport failed (local player not ready)");
												}
											}
										}

										if (gui->button("Delete Waypoint", 2))
										{
											if (selected_wp_idx >= 0 && selected_wp_idx < (int)wps.size())
											{
												waypoints::remove_waypoint((size_t)selected_wp_idx);
												selected_wp_idx = -1;
												notifications::add("Waypoint Deleted!");
											}
										}
										gui->sameline();
										if (gui->button("Clear All", 2))
										{
											waypoints::clear_waypoints();
											selected_wp_idx = -1;
											notifications::add("All Waypoints Cleared!");
										}
									}
									gui->end_child();
								}
								gui->end_group();
							}
							else if (waypoints_subtab == 1)
							{
								static char profile_name[64] = "default";
								static int selected_profile_idx = -1;
								std::vector<std::string> profiles = waypoints::get_profile_list();

								gui->begin_group();
								{
									gui->begin_child("Profiles", 1, 2);
									{
										gui->push_font(var->font.tahoma);
										if (profiles.empty())
										{
											gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));
											TextUnformatted("No profiles found. Save one below!");
											gui->pop_style_color();
										}
										else
										{
											for (size_t i = 0; i < profiles.size(); i++)
											{
												bool is_sel = (selected_profile_idx == (int)i);
												if (is_sel)
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->accent));
												else
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));

												std::string disp = profiles[i];
												ImVec2 sz = CalcTextSize(disp.c_str());
												float avail_w = GetContentRegionAvail().x;
												float cx = (avail_w - sz.x) * 0.5f;
												if (cx > 0) SetCursorPosX(cx);

												draw->text_outline(disp.c_str());
												if (IsItemClicked())
												{
													selected_profile_idx = (int)i;
													strncpy_s(profile_name, profiles[i].c_str(), sizeof(profile_name) - 1);
												}

												gui->pop_style_color();

												ImVec2 item_max = GetItemRectMax();
												float win_min_x = GetWindowPos().x + elements->widgets.padding.x;
												float win_max_x = GetWindowPos().x + GetWindowWidth() - elements->widgets.padding.x;
												float line_y = item_max.y + 4.0f;
												draw->line(GetWindowDrawList(), ImVec2(win_min_x, line_y), ImVec2(win_max_x, line_y), draw->get_clr(clr->window.stroke));
												SetCursorPosY(GetCursorPosY() + 7.0f);
											}
										}
										gui->pop_font();
									}
									gui->end_child();

									gui->begin_child("Actions", 1, 2);
									{
										gui->text_field("##profile_name_field", profile_name, sizeof(profile_name));

										if (gui->button("Save Profile", 2))
										{
											if (strlen(profile_name) > 0)
											{
												waypoints::save_profile(profile_name);
												profiles = waypoints::get_profile_list();
												notifications::add("Profile Saved: " + std::string(profile_name));
											}
										}
										gui->sameline();
										if (gui->button("Load Profile", 2))
										{
											if (selected_profile_idx >= 0 && selected_profile_idx < (int)profiles.size())
											{
												waypoints::load_profile(profiles[selected_profile_idx]);
												notifications::add("Profile Loaded: " + profiles[selected_profile_idx]);
											}
										}

										if (gui->button("Save for Game", 2))
										{
											if (waypoints::save_game_waypoints())
												notifications::add("Saved waypoints for current game!");
											else
												notifications::add("Failed: Not in game");
										}
										gui->sameline();
										if (gui->button("Load for Game", 2))
										{
											if (waypoints::load_game_waypoints())
												notifications::add("Loaded waypoints for current game!");
											else
												notifications::add("Failed: No profile for current game");
										}

										if (gui->button("Delete Profile", 2))
										{
											if (selected_profile_idx >= 0 && selected_profile_idx < (int)profiles.size())
											{
												waypoints::delete_profile(profiles[selected_profile_idx]);
												profiles = waypoints::get_profile_list();
												selected_profile_idx = -1;
												notifications::add("Profile Deleted!");
											}
										}
										gui->sameline();
										if (gui->button("Open Folder", 2))
										{
											ShellExecuteA(NULL, "open", waypoints::get_waypoints_directory().c_str(), NULL, NULL, SW_SHOWNORMAL);
										}
									}
									gui->end_child();
								}
								gui->end_group();
							}
						}
						gui->end_content();
					}
				}
				gui->end();
				gui->sameline();
			}
			else
			{
				s_style_was_open = false;
			}

			if (var->gui.current_section[6])
			{
				place_section_window("Server Browser", ImVec2(540.f, 600.f));
				gui->set_next_window_size(ImVec2(540, 600), ImGuiCond_Once);
				gui->set_next_window_size_constraints(ImVec2(420, 380), GetIO().DisplaySize);
				gui->begin("Server Browser", nullptr, var->window.flags);
				{
					draw->window_decorations();

					{
						static int server_subtab = 0;
						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar));
						gui->begin_group();
						{
							gui->sub_section("Servers", 0, server_subtab, 2);
							gui->sub_section("Join", 1, server_subtab, 2);
						}
						gui->end_group();

						if (serverbrowser::browser->input_place_id[0] == '\0' || (serverbrowser::browser->all_servers.empty() && !serverbrowser::browser->is_loading))
						{
							serverbrowser::browser->refresh_current_game();
							uint64_t pid = serverbrowser::browser->get_target_place_id();
							if (pid > 0 && serverbrowser::browser->all_servers.empty() && !serverbrowser::browser->is_loading)
							{
								serverbrowser::browser->cursor_history.clear();
								serverbrowser::browser->current_page = 1;
								serverbrowser::browser->fetch_servers_async(pid);
							}
						}

						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + elements->section.height - 1));
						gui->begin_content();
						{
							if (server_subtab == 0)
							{
								float controls_height = 115.f;
								float total_avail = GetWindowHeight() - elements->content.padding.y * 2.f;
								float list_height = total_avail - controls_height - elements->content.spacing.y;

								gui->begin_group();
								{
									gui->begin_child("Server List", 1, 1, ImVec2(0, list_height));
									{
										gui->push_font(var->font.tahoma);
										std::lock_guard<std::mutex> lock(serverbrowser::browser->mtx);

										if (serverbrowser::browser->is_loading)
										{
											gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->accent));
											TextUnformatted(serverbrowser::browser->status_message.c_str());
											gui->pop_style_color();
										}
										else if (serverbrowser::browser->filtered_servers.empty())
										{
											if (!serverbrowser::browser->status_message.empty() && serverbrowser::browser->status_message != "Ready")
											{
												gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->accent));
												TextUnformatted(serverbrowser::browser->status_message.c_str());
												gui->pop_style_color();
												ImGui::Dummy(ImVec2(0, 4));
											}

											gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));
											if (serverbrowser::browser->all_servers.empty())
											{
												TextUnformatted("Click 'Rescan Servers' to scan for active servers.");
											}
											else
											{
												TextUnformatted("No servers match the active filters.");
											}
											gui->pop_style_color();
										}
										else
										{
											uint64_t current_pid = serverbrowser::browser->get_target_place_id();
											std::string active_jid = serverbrowser::browser->active_job_id;

											for (size_t i = 0; i < serverbrowser::browser->filtered_servers.size(); i++)
											{
												const auto& s = serverbrowser::browser->filtered_servers[i];
												bool is_current = (!active_jid.empty() && s.id == active_jid);

												std::stringstream title_ss;
												title_ss << "#" << (i + 1) << " | " << s.playing << "/" << s.max_players << " Players";
												if (s.ping > 0) title_ss << " | " << s.ping << "ms";
												if (s.fps > 0.0f) title_ss << " | " << std::fixed << std::setprecision(0) << s.fps << " FPS";
												if (is_current) title_ss << " [CURRENT]";

												if (is_current)
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->accent));
												else
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text));

												draw->text_outline(title_ss.str().c_str());
												gui->pop_style_color();

												std::string join_lbl = "Join##" + std::to_string(i);
												std::string copy_lbl = "Copy ID##" + std::to_string(i);
												std::string tele_lbl = "Script##" + std::to_string(i);

												if (gui->button(join_lbl.c_str(), 3))
												{
													serverbrowser::browser->join_server(current_pid, s.id);
												}
												gui->sameline();
												if (gui->button(copy_lbl.c_str(), 3))
												{
													serverbrowser::browser->copy_job_id(s.id);
												}
												gui->sameline();
												if (gui->button(tele_lbl.c_str(), 3))
												{
													serverbrowser::browser->copy_teleport_script(current_pid, s.id);
												}

												ImGui::Dummy(ImVec2(0, 4));
											}
										}
										gui->pop_font();
									}
									gui->end_child();

									gui->begin_child("Controls & Filter", 1, 1, ImVec2(0, controls_height));
									{
										if (gui->button("Rescan Servers", 1))
										{
											serverbrowser::browser->refresh_current_game();
											uint64_t pid = serverbrowser::browser->get_target_place_id();
											if (pid > 0)
											{
												serverbrowser::browser->cursor_history.clear();
												serverbrowser::browser->current_page = 1;
												serverbrowser::browser->fetch_servers_async(pid);
												notifications::add("Rescanning Place " + std::to_string(pid));
											}
											else
											{
												notifications::add("No active Place ID found");
											}
										}

										gui->dropdown("Sort Order", &serverbrowser::browser->sort_mode, server_sort_names, IM_ARRAYSIZE(server_sort_names));
										if (IsItemDeactivatedAfterEdit() || IsItemEdited())
										{
											std::lock_guard<std::mutex> lock(serverbrowser::browser->mtx);
											serverbrowser::browser->apply_filter();
										}

										gui->checkbox("Exclude Full Servers", &serverbrowser::browser->exclude_full);
										if (IsItemEdited())
										{
											std::lock_guard<std::mutex> lock(serverbrowser::browser->mtx);
											serverbrowser::browser->apply_filter();
										}

										if (serverbrowser::browser->current_page > 1)
										{
											if (gui->button("<< Prev Page", 2))
											{
												serverbrowser::browser->prev_page();
											}
											gui->sameline();
										}

										if (!serverbrowser::browser->next_cursor.empty())
										{
											if (gui->button("Next Page >>", 2))
											{
												serverbrowser::browser->next_page();
											}
										}
									}
									gui->end_child();
								}
								gui->end_group();
							}
							else if (server_subtab == 1)
							{
								gui->begin_group();
								{
									gui->begin_child("Quick Join by Job ID", 1, 1);
									{
										static char custom_job_id[128] = "";
										gui->push_font(var->font.tahoma);
										gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));
										TextUnformatted("Direct Connect to Server Instance:");
										gui->pop_style_color();
										gui->pop_font();

										gui->text_field("##custom_job_id_input", custom_job_id, sizeof(custom_job_id));

										if (gui->button("Join via Job ID", 2))
										{
											uint64_t pid = strtoull(serverbrowser::browser->input_place_id, nullptr, 10);
											if (pid > 0 && strlen(custom_job_id) > 0)
											{
												serverbrowser::browser->join_server(pid, custom_job_id);
											}
											else
											{
												notifications::add("Enter valid Place ID & Job ID");
											}
										}
										gui->sameline();
										if (gui->button("Copy Teleport Code", 2))
										{
											uint64_t pid = strtoull(serverbrowser::browser->input_place_id, nullptr, 10);
											if (pid > 0 && strlen(custom_job_id) > 0)
											{
												serverbrowser::browser->copy_teleport_script(pid, custom_job_id);
											}
										}

										ImGui::Dummy(ImVec2(0, 10));

										gui->push_font(var->font.tahoma);
										gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->accent));
										TextUnformatted("Current Session Info:");
										gui->pop_style_color();

										std::stringstream info_ss;
										info_ss << "Active Place ID: " << serverbrowser::browser->active_place_id << "\n";
										info_ss << "Active Job ID:\n" << (serverbrowser::browser->active_job_id.empty() ? "None / Not in Game" : serverbrowser::browser->active_job_id) << "\n";
										info_ss << "Status: " << serverbrowser::browser->status_message;

										gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text_inactive));
										TextUnformatted(info_ss.str().c_str());
										gui->pop_style_color();

										if (!serverbrowser::browser->active_job_id.empty())
										{
											if (gui->button("Copy Current Job ID", 2))
											{
												serverbrowser::browser->copy_job_id(serverbrowser::browser->active_job_id);
											}
											gui->sameline();
											if (gui->button("Rejoin Current Server", 2))
											{
												serverbrowser::browser->join_server(serverbrowser::browser->active_place_id, serverbrowser::browser->active_job_id);
											}
										}

										gui->pop_font();
									}
									gui->end_child();
								}
								gui->end_group();
							}
						}
						gui->end_content();
					}
				}
				gui->end();
				gui->sameline();
			}

			if (var->gui.current_section[9])
			{
				place_section_window("NPC Manager", ImVec2(380.f, 420.f));
				gui->set_next_window_size(ImVec2(380, 420), ImGuiCond_Once);
				gui->set_next_window_size_constraints(ImVec2(300, 320), GetIO().DisplaySize);
				gui->begin("NPC Manager", nullptr, var->window.flags);
				{
					draw->window_decorations();

					{
						static int npc_subtab = 0;
						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar));
						gui->begin_group();
						{
							gui->sub_section("NPC Paths", 0, npc_subtab, 2);
							gui->sub_section("Settings", 1, npc_subtab, 2);
						}
						gui->end_group();

						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + elements->section.height - 1));
						gui->begin_content();
						{
							if (npc_subtab == 0)
							{
								gui->begin_group();
								{
									gui->begin_child("Configured Paths", 1, 2);
									{
										gui->push_font(var->font.tahoma);
										if (!settings::playerlist::active_npc_paths.empty())
										{
											static std::string selected_path = "";
											std::vector<std::string> path_vec(settings::playerlist::active_npc_paths.begin(), settings::playerlist::active_npc_paths.end());
											for (size_t i = 0; i < path_vec.size(); i++)
											{
												bool is_sel = (selected_path == path_vec[i]);
												if (is_sel)
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->accent));
												else
													gui->push_style_color(ImGuiCol_Text, draw->get_clr(clr->widgets.text));

												draw->text_outline(path_vec[i].c_str());
												if (IsItemClicked())
												{
													selected_path = path_vec[i];
													strncpy_s(settings::playerlist::npc_path_input, path_vec[i].c_str(), sizeof(settings::playerlist::npc_path_input) - 1);
												}

												gui->pop_style_color();

												ImVec2 item_max = GetItemRectMax();
												float win_min_x = GetWindowPos().x + elements->widgets.padding.x;
												float win_max_x = GetWindowPos().x + GetWindowWidth() - elements->widgets.padding.x;
												float line_y = item_max.y + 4.0f;
												draw->line(GetWindowDrawList(), ImVec2(win_min_x, line_y), ImVec2(win_max_x, line_y), draw->get_clr(clr->window.stroke));
												SetCursorPosY(GetCursorPosY() + 7.0f);
											}
										}
										gui->pop_font();
									}
									gui->end_child();

									gui->begin_child("Path Actions", 1, 2);
									{
										gui->text_field("##npc_path_in", settings::playerlist::npc_path_input, sizeof(settings::playerlist::npc_path_input));

										if (gui->button("Add Path", 2))
										{
											if (strlen(settings::playerlist::npc_path_input) > 0)
											{
												settings::playerlist::active_npc_paths.insert(settings::playerlist::npc_path_input);
												notifications::add("NPC Path Added: " + std::string(settings::playerlist::npc_path_input));
											}
										}
										gui->sameline();
										if (gui->button("Remove Path", 2))
										{
											if (strlen(settings::playerlist::npc_path_input) > 0)
											{
												settings::playerlist::active_npc_paths.erase(settings::playerlist::npc_path_input);
												notifications::add("NPC Path Removed");
											}
										}

										if (gui->button("Clear All Paths", 1))
										{
											settings::playerlist::active_npc_paths.clear();
											notifications::add("All NPC Paths Cleared!");
										}
									}
									gui->end_child();
								}
								gui->end_group();
							}
							else if (npc_subtab == 1)
							{
								gui->begin_group();
								{
									gui->begin_child("NPC Options", 1, 1);
									{
										gui->checkbox("Bot Support", &settings::misc::bot_support);
										gui->checkbox("Only Workspace Bots", &settings::misc::only_workspace_bots);
									}
									gui->end_child();
								}
								gui->end_group();
							}
						}
						gui->end_content();
					}
				}
				gui->end();
				gui->sameline();
			}
	}

		var->window.width = GetCurrentWindow()->ContentSize.x + style->ItemSpacing.x;

		if (IsMouseHoveringRect(pos, pos + size))
			SetWindowFocus();
	}
	gui->end();
	gui->pop_style_var();
	}

	if (show_load_confirmation)
	{
		gui->set_next_window_size(ImVec2(270, 140), ImGuiCond_Always);
		gui->set_next_window_pos(ImVec2(GetIO().DisplaySize.x * 0.5f - 135.f, GetIO().DisplaySize.y * 0.5f - 70.f), ImGuiCond_Appearing);
		if (gui->begin("Confirmation", &show_load_confirmation, var->window.flags | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse))
		{
			ImDrawList* dl = GetWindowDrawList();
			dl->PushClipRectFullScreen();
			dl->AddRectFilled(ImVec2(0, 0), GetIO().DisplaySize, ImColor(0, 0, 0, 140));
			dl->PopClipRect();

			draw->window_decorations();
			{
				gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + 1));
				gui->begin_content();
				{
					gui->begin_group();
					{
						gui->begin_child("##ConfirmBox", 1, 1, ImVec2(0, 0));
						{
							ImGui::Text(is_overwrite_confirmation ? "Overwrite Config?" : "Load Config?");

							if (gui->button("Confirm", 2))
							{
								bool keep_disable = settings::config_system::disable_confirmations;
								if (!pending_load_config_name.empty())
								{
									if (is_overwrite_confirmation)
									{
										config::save_config(pending_load_config_name);
										notifications::add("Config Overwritten: " + pending_load_config_name);
									}
									else
									{
										config::load_config(pending_load_config_name);
										notifications::add("Config Loaded: " + pending_load_config_name);
									}
								}
								settings::config_system::disable_confirmations = keep_disable;
								show_load_confirmation = false;
							}
							gui->sameline();
							if (gui->button("Cancel", 2))
							{
								show_load_confirmation = false;
							}

							gui->checkbox("Disable Confirmations", &settings::config_system::disable_confirmations);
						}
						gui->end_child();
					}
					gui->end_group();
				}
				gui->end_content();
			}
		}
		gui->end();
	}

	if (show_unload_confirmation)
	{
		gui->set_next_window_size(ImVec2(270, 105), ImGuiCond_Always);
		gui->set_next_window_pos(ImVec2(GetIO().DisplaySize.x * 0.5f - 135.f, GetIO().DisplaySize.y * 0.5f - 52.5f), ImGuiCond_Appearing);
		if (gui->begin("Confirmation##UnloadConfirmWindow", &show_unload_confirmation, var->window.flags | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse))
		{
			ImDrawList* dl = GetWindowDrawList();
			dl->PushClipRectFullScreen();
			dl->AddRectFilled(ImVec2(0, 0), GetIO().DisplaySize, ImColor(0, 0, 0, 140));
			dl->PopClipRect();

			draw->window_decorations();
			{
				gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + 1));
				gui->begin_content();
				{
					gui->begin_group();
					{
						gui->begin_child("##UnloadConfirmBox", 1, 1, ImVec2(0, 0));
						{
							ImGui::Text("Unload Cheat?");

							if (gui->button("Confirm##ConfirmUnloadBtn", 2))
							{
								show_unload_confirmation = false;
								notifications::add("Unloading...");
								HWND overlay = (::render && ::render->detail) ? ::render->detail->window : nullptr;
								std::thread([overlay]() {

									Cheat::Features::SkyShader::Stop();
									nativechams::Stop();
									std::this_thread::sleep_for(std::chrono::milliseconds(150));
									if (overlay && IsWindow(overlay)) {
										ShowWindow(overlay, SW_HIDE);
									}
									HWND console = GetConsoleWindow();
									if (console && IsWindow(console)) {
										ShowWindow(console, SW_HIDE);
									}
									std::this_thread::sleep_for(std::chrono::milliseconds(50));
									ExitProcess(0);
								}).detach();
							}
							gui->sameline();
							if (gui->button("Cancel##CancelUnloadBtn", 2))
							{
								show_unload_confirmation = false;
							}
						}
						gui->end_child();
					}
					gui->end_group();
				}
				gui->end_content();
			}
		}
		gui->end();
	}

	explorer::explorer->render_decompiled_windows();
}
