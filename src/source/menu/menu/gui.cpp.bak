												ImVec2 text_size = CalcTextSize(display_name.c_str());
												float avail_w = GetContentRegionAvail().x;
												float center_pos_x = (avail_w - text_size.x) * 0.5f;
												if (center_pos_x > 0)
													SetCursorPosX(center_pos_x);

