												if (IsItemClicked())
												{
													selected_cfg_index = (int)i;
													strncpy_s(new_config_name, cfg_list[i].name.c_str(), sizeof(new_config_name) - 1);
												}

												gui->pop_style_color();

												ImVec2 item_max = GetItemRectMax();
												float win_min_x = GetWindowPos().x + elements->widgets.padding.x;
												float win_max_x = GetWindowPos().x + GetWindowWidth() - elements->widgets.padding.x;
												float line_y = item_max.y + 4.0f;
												draw->line(GetWindowDrawList(), ImVec2(win_min_x, line_y), ImVec2(win_max_x, line_y), draw->get_clr(clr->window.stroke));
												SetCursorPosY(GetCursorPosY() + 7.0f);
											}
										}
										gui->pop_font();
									}
									gui->end_child();

									gui->begin_child("Actions", 1, 2);
									{
										gui->text_field("##configname", new_config_name, sizeof(new_config_name));

										if (gui->button("Create", 2))
										{
											if (strlen(new_config_name) > 0)
											{
												config::save_config(new_config_name);
												cfg_list = config::get_config_list();
												notifications::add("Config Created & Saved!");
											}
										}
										gui->sameline();
										if (gui->button("Delete", 2))
										{
											if (selected_cfg_index >= 0 && selected_cfg_index < (int)cfg_list.size())
											{
												config::delete_config(cfg_list[selected_cfg_index].name);
												cfg_list = config::get_config_list();
												selected_cfg_index = -1;
												notifications::add("Config Deleted!");
											}
										}

										if (gui->button("Load", 2))
										{
											if (selected_cfg_index >= 0 && selected_cfg_index < (int)cfg_list.size())
											{
												if (settings::config_system::disable_confirmations)
												{
													config::load_config(cfg_list[selected_cfg_index].name);
													notifications::add("Config Loaded: " + cfg_list[selected_cfg_index].name);
												}
												else
												{
													pending_load_config_name = cfg_list[selected_cfg_index].name;
													is_overwrite_confirmation = false;
													show_load_confirmation = true;
												}
											}
										}
										gui->sameline();
										if (gui->button("Overwrite", 2))
										{
											std::string target_cfg = (strlen(new_config_name) > 0) ? new_config_name : ((selected_cfg_index >= 0 && selected_cfg_index < (int)cfg_list.size()) ? cfg_list[selected_cfg_index].name : "");
											if (!target_cfg.empty())
											{
												if (settings::config_system::disable_confirmations)
												{
													config::save_config(target_cfg);
													cfg_list = config::get_config_list();
													notifications::add("Config Overwritten: " + target_cfg);
												}
												else
												{
													pending_load_config_name = target_cfg;
													is_overwrite_confirmation = true;
													show_load_confirmation = true;
												}
											}
										}

										if (gui->button("Auto Load", 1))
										{
											if (selected_cfg_index >= 0 && selected_cfg_index < (int)cfg_list.size())
											{
												config::set_autoload(cfg_list[selected_cfg_index].name);
												notifications::add("Autoload Set: " + cfg_list[selected_cfg_index].name);
											}
										}

										if (gui->button("Clear Autoload", 1))
										{
