static void place_section_window(const char* name, const ImVec2& wanted_size)
{
	static int last_frame = -1;
	static float cursor_x = 0.f;
	static float cursor_y = 0.f;
	static float row_height = 0.f;

	const ImGuiViewport* viewport = ImGui::GetMainViewport();
	const float margin = 18.f;
	const float gap = 12.f;
	const float start_x = viewport->WorkPos.x + margin;
	const float start_y = viewport->WorkPos.y + 86.f;
	const float right_limit = viewport->WorkPos.x + viewport->WorkSize.x - margin;
	const float bottom_limit = viewport->WorkPos.y + viewport->WorkSize.y - margin;

	const int frame = ImGui::GetFrameCount();
	if (last_frame != frame)
	{
		last_frame = frame;
		cursor_x = start_x;
		cursor_y = start_y;
		row_height = 0.f;
	}

	ImGuiWindow* window = ImGui::FindWindowByName(name);
	const bool first_appearance = (window == nullptr) || (window->LastFrameActive + 1 < frame);

	ImVec2 size = wanted_size;
	if (window != nullptr && window->Size.x > 0.f && window->Size.y > 0.f)
		size = window->Size;

	if (cursor_x > start_x && cursor_x + size.x > right_limit)
	{
		cursor_x = start_x;
		cursor_y += row_height + gap;
		row_height = 0.f;
	}

	if (first_appearance)
	{
		float y = cursor_y;
		if (y + size.y > bottom_limit)
			y = (std::max)(start_y, bottom_limit - size.y);
		ImGui::SetNextWindowPos(ImVec2(cursor_x, y), ImGuiCond_Always);
	}

	cursor_x += size.x + gap;
	row_height = (std::max)(row_height, size.y);
}

void c_gui::render()
{
	static bool s_theme_initialized = false;
	if (!s_theme_initialized)
	{
		Theme::ApplyTheme(settings::theme::preset);
		s_theme_initialized = true;
	}

	playerlist::tick();

	var->gui.menu_alpha = ImClamp(var->gui.menu_alpha + (gui->fixed_speed(8.f) * (var->gui.menu_opened ? 1.f : -1.f)), 0.f, 1.f);

	if (var->gui.menu_alpha <= 0.01f)
		return;

	gui->set_next_window_pos(ImVec2(GetIO().DisplaySize.x / 2 - var->window.width / 2, 20));
	gui->set_next_window_size(ImVec2(var->window.width, elements->section.size.y + var->window.spacing.y * 2 - 1));
	gui->push_style_var(ImGuiStyleVar_Alpha, var->gui.menu_alpha);
	gui->begin("Cortex", nullptr, var->window.main_flags);
	{
		const ImVec2 pos = GetWindowPos();
		const ImVec2 size = GetWindowSize();
		ImDrawList* draw_list = GetWindowDrawList();
		ImGuiStyle* style = &GetStyle();

		{
			style->WindowPadding = var->window.padding;
			style->PopupBorderSize = var->window.border_size;
			style->WindowBorderSize = var->window.border_size;
			style->ItemSpacing = var->window.spacing;
			style->WindowShadowSize = var->window.shadow_size;
			style->ScrollbarSize = var->window.scrollbar_size;
			style->WindowRounding = var->window.rounding;
			style->ChildRounding = var->window.child_rounding;
			style->FrameRounding = var->window.frame_rounding;
			style->GrabRounding = var->window.grab_rounding;
			style->Colors[ImGuiCol_WindowShadow] = { clr->accent.Value.x, clr->accent.Value.y, clr->accent.Value.z, var->window.shadow_alpha };
		}

		{
			draw->rect(GetBackgroundDrawList(), pos - ImVec2(1, 1), pos + size + ImVec2(1, 1), draw->get_clr({0, 0, 0, 0.5f}));
			draw->rect_filled(draw_list, pos, pos + size, draw->get_clr(clr->window.background_one));
			draw->line(draw_list, pos + ImVec2(1, 1), pos + ImVec2(size.x - 1, 1), draw->get_clr(clr->accent), 1);
			draw->line(draw_list, pos + ImVec2(1, 2), pos + ImVec2(size.x - 1, 2), draw->get_clr(clr->accent, 0.4f), 1);
			draw->rect(draw_list, pos, pos + size, draw->get_clr(clr->window.stroke));
		}

		static int s_home_subtabs = 0;

		{
			gui->set_cursor_pos(style->ItemSpacing);
			gui->begin_group();
			{
				static const int dock_order[] = { 0, 1, 3, 4, 5, 6, 7, 9, 8 };
				for (int idx : dock_order)
				{
					if (idx >= 0 && idx < IM_ARRAYSIZE(var->gui.current_section))
						gui->section(var->gui.section_icons[idx], &var->gui.current_section[idx]);
				}
			}
			gui->end_group();
		}

		{
			if (var->gui.current_section[0])
			{
				float start_x = (GetIO().DisplaySize.x - 600.f) * 0.5f;
				float start_y = 65.f;
				gui->set_next_window_pos(ImVec2(start_x, start_y), ImGuiCond_Once);
				gui->set_next_window_size(ImVec2(600, 645), ImGuiCond_Once);
				gui->set_next_window_size_constraints(ImVec2(600, 700), GetIO().DisplaySize);
				gui->begin("Home", nullptr, var->window.flags);
				{
					draw->window_decorations();

					{
						int& subtabs = s_home_subtabs;
						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar));
						gui->begin_group();
						{
							gui->sub_section("Assist", 0, subtabs, 4);
							gui->sub_section("Players", 1, subtabs, 4);
							gui->sub_section("Lightning", 2, subtabs, 4);
							gui->sub_section("Exploits", 3, subtabs, 4);
						}
						gui->end_group();

						gui->set_cursor_pos(elements->content.window_padding + ImVec2(0, var->window.titlebar + elements->section.height - 1));
						gui->begin_content();
						{
							if (subtabs == 0)
							{
								gui->begin_group();
								{
									gui->begin_child("Aimbot", 2, 1);
									{
										gui->checkbox("Enabled", &settings::aimbot::enabled, &settings::aimbot::keybind, &settings::aimbot::activation_mode);
										gui->dropdown("Aim Mode", &settings::aimbot::mode, aim_modes, IM_ARRAYSIZE(aim_modes));
										gui->dropdown("Target Part", &settings::aimbot::target_part, target_parts, IM_ARRAYSIZE(target_parts));
										gui->dropdown("Air Target Part", &settings::aimbot::air_part, target_parts, IM_ARRAYSIZE(target_parts));
										if (settings::aimbot::mode == 0)
										{
											gui->slider_float("Mouse Sensitivity", &settings::aimbot::mouse_sensitivity, 0.f, 10.f);
										}
										gui->slider_float("Fov", &settings::aimbot::fov, 0.f, 600.f);
										gui->checkbox("Sticky Aim", &settings::aimbot::sticky_aim);
										gui->checkbox("Dynamic Fov", &settings::aimbot::dynamic_fov);
										gui->checkbox("Draw Fov", &settings::aimbot::draw_fov, settings::aimbot::fov_circle_colour);
										gui->checkbox("Fill Fov", &settings::aimbot::fill_fov, settings::aimbot::fov_fill_colour);
										gui->checkbox("Smoothness", &settings::aimbot::smoothing);
										if (settings::aimbot::smoothing)
										{
											gui->slider_float("Smoothing X", &settings::aimbot::smoothingx, 1.f, 100.f);
											gui->slider_float("Smoothing Y", &settings::aimbot::smoothingy, 1.f, 100.f);
										}
										gui->checkbox("Prediction", &settings::aimbot::enable_prediction);
										if (settings::aimbot::enable_prediction)
										{
											gui->slider_float("Prediction X", &settings::aimbot::prediction_x, 0.f, 100.f);
											gui->slider_float("Prediction Y", &settings::aimbot::prediction_y, 0.f, 100.f);
										}
										gui->checkbox("Team Check", &settings::aimbot::teamcheck);

										gui->checkbox("Universal Teamcheck", &settings::teamcheck);
										gui->checkbox("Knock Check", &settings::aimbot::knock_check);
									}
									gui->end_child();
								}
								gui->end_group();

								gui->sameline();

								gui->begin_group();
								{
									gui->begin_child("Silent Aim", 2, 2);
									{
										gui->checkbox("Enabled", &settings::silentaim::enabled, &settings::silentaim::keybind, &settings::silentaim::activation_mode);
										gui->dropdown("Method", &settings::silentaim::method, silentaim_methods, IM_ARRAYSIZE(silentaim_methods));
										gui->dropdown("Target Bone", &settings::silentaim::target_part, target_parts, IM_ARRAYSIZE(target_parts));
										if (settings::silentaim::method == 0)
										{
											gui->checkbox("360 Mode", &settings::raycast_silentaim::mode_360, &settings::raycast_silentaim::mode_360_keybind, &settings::raycast_silentaim::mode_360_activation_mode);
											gui->checkbox("Wallbang", &settings::raycast_silentaim::magic_bullet, &settings::raycast_silentaim::magic_bullet_keybind, &settings::raycast_silentaim::magic_bullet_activation_mode);
											if (settings::raycast_silentaim::magic_bullet)
											{
												static const char* wb_methods[] = { "Engine", "Position" };
												gui->dropdown("Wallbang Method", &settings::raycast_silentaim::magic_bullet_method, wb_methods, IM_ARRAYSIZE(wb_methods));
											}
										}
										gui->slider_float("Fov", &settings::silentaim::fov, 0.f, 1000.f);
										gui->checkbox("Draw Fov", &settings::silentaim::draw_fov, settings::silentaim::fov_circle_colour);
										gui->checkbox("Fill Fov", &settings::silentaim::fill_fov, settings::silentaim::fov_fill_colour);
										gui->checkbox("Snapline", &settings::silentaim::snapline, settings::silentaim::snapline_colour);
										gui->checkbox("Team Check", &settings::silentaim::teamcheck);
										gui->checkbox("Gun Check", &settings::silentaim::guncheck);
										gui->checkbox("Knock Check", &settings::silentaim::knock_check);
										gui->checkbox("Forcefield Check", &settings::silentaim::forcefield_check);
									}
									gui->end_child();

									gui->begin_child("Triggerbot", 2, 2);
									{
										gui->checkbox("Triggerbot", &settings::triggerbot::enabled, &settings::triggerbot::keybind, &settings::triggerbot::activation_mode);
										gui->dropdown("TriggerBot Part", &settings::triggerbot::target_part, target_parts, IM_ARRAYSIZE(target_parts));
										gui->slider_float("Delay", &settings::triggerbot::delay_ms, 0.f, 500.f, false, "%.0fms");
										gui->slider_float("Cooldown", &settings::triggerbot::cooldown_ms, 0.f, 1000.f, false, "%.0fms");
										gui->checkbox("Team Check", &settings::triggerbot::teamcheck);
										gui->checkbox("Wall Check", &settings::triggerbot::wallcheck);
										gui->checkbox("Knock Check", &settings::triggerbot::knock_check);
										gui->checkbox("Gun Check", &settings::triggerbot::guncheck);
									}
									gui->end_child();
								}
								gui->end_group();
							}
							else if (subtabs == 1)
							{
								float total_h = GetWindowHeight() - elements->content.padding.y * 2.f - elements->content.spacing.y;
								float h_top = std::round(total_h * 0.58f);
								float h_bot = total_h - h_top;

								gui->begin_group();
								{
									ImGuiID visuals_id = GetCurrentWindow()->GetID("Visuals Options");

									gui->begin_multi_subtab(
										"Visuals Options",
										2,
										1,
										3,
										ImVec2(0, h_top),
										{ "Enemies", "Friendlies", "Client" }
									);
									{
										int vis_subtab = gui->get_child_subtab(visuals_id);
										settings::visuals::priority_settings_t* cur_settings = (vis_subtab == 0)
											? &settings::visuals::hostile
											: ((vis_subtab == 1) ? &settings::visuals::friendly : &settings::visuals::neutral);

										gui->checkbox("Enable", &settings::visuals::enabled, &settings::visuals::keybind, &settings::visuals::activation_mode);

										gui->checkbox("Box", &cur_settings->box, cur_settings->colour);
										if (cur_settings->box)
										{
											gui->dropdown("Box Type", &cur_settings->box_type, box_types, IM_ARRAYSIZE(box_types));
											if (cur_settings->box_type == 0)
											{
												gui->slider_float("Corner Length", &cur_settings->corner_box_length, 0.1f, 1.0f, false, "%.2f");
											}
											gui->checkbox("Box Inline", &cur_settings->box_inline);

											gui->checkbox("Box Gradient", &cur_settings->box_gradient, cur_settings->colour, cur_settings->box_colour_mid, cur_settings->box_colour_low);
											if (cur_settings->box_gradient)
											{
												const char* gradient_styles[] = { "Vertical", "Horizontal", "Pulse" };
												gui->dropdown("Gradient Style", &cur_settings->box_gradient_type, gradient_styles, IM_ARRAYSIZE(gradient_styles));
												if (cur_settings->box_gradient_type == 2)
												{
													gui->slider_float("Pulse Speed", &cur_settings->box_pulse_speed, 0.1f, 10.0f, false, "%.1fx");
												}
											}

											gui->checkbox("Box Filled", &cur_settings->box_fill, cur_settings->box_fill_colour);
											if (cur_settings->box_fill)
											{
